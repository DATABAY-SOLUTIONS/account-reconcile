<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_reconcile_model_form" model="ir.ui.view">
        <field name="name">account.reconcile.model.form</field>
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account.view_account_reconcile_model_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@id='filters_left_column']" position="after">
                <group id="oca_matching_options">
                    <field name="rule_type" invisible="1" />
                    <field
                        name="unique_matching"
                        invisible="rule_type!='invoice_matching'"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
